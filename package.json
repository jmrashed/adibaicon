{
  "name": "adibaicon",
  "version": "2.2.2",
  "description": "A lightweight, customizable icon font library with 78+ letter-based and UI icons in multiple styles. Includes React/Vue components, accessibility features, and PWA support.",
  "main": "dist/css/adibaIcon.css",
  "module": "dist/js/adibaIcon.esm.js",
  "browser": "dist/css/adibaIcon.min.css",
  "style": "dist/css/adibaIcon.css",
  "sass": "src/scss/adibaIcon.scss",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/",
    "src/scss/",
    "src/less/",
    "integrations/",
    "README.md",
    "LICENSE",
    "DISTRIBUTION.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:webpack": "webpack --mode=production",
    "dev": "webpack --mode=development --watch",
    "optimize:fonts": "node scripts/optimize-fonts.js",
    "build:all": "npm run clean && npm run build && npm run optimize:fonts",
    "prepublishOnly": "npm run build:all && npm run docs:version && npm run test",
    "docs:version": "node scripts/version-docs.js",
    "docs:serve": "npx http-server docs -p 8080",
    "lint": "eslint . --ext .js,.jsx,.ts",
    "lint:fix": "eslint . --ext .js,.jsx,.ts --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "clean": "rm -rf dist/ && echo 'Dist cleaned'",
    "generate:svg": "node scripts/generate-svg.js",
    "generate:docs": "echo 'Icon documentation generated'",
    "cdn:build": "node scripts/cdn-build.js",
    "release": "node scripts/release.js",
    "git:release": "node scripts/git-release.js",
    "serve": "npx http-server dist -p 8080",
    "deploy": "node scripts/quick-deploy.js",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmrashed/adibaicon.git"
  },
  "keywords": [
    "icon",
    "font",
    "css",
    "icons",
    "web-font",
    "typography",
    "ui",
    "design",
    "letters",
    "alphabet",
    "adibaicon",
    "react",
    "vue",
    "accessibility",
    "pwa",
    "responsive",
    "lightweight",
    "customizable",
    "scss",
    "sass",
    "less"
  ],
  "author": {
    "name": "Md Rasheduzzaman",
    "email": "jmrashed@gmail.com",
    "url": "https://github.com/jmrashed"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jmrashed/adibaicon/issues"
  },
  "homepage": "https://adibaicon.vercel.app",
  "cdn": "https://cdn.jsdelivr.net/npm/adibaicon@latest/dist/css/adibaIcon.min.css",
  "jsdelivr": "dist/css/adibaIcon.min.css",
  "unpkg": "dist/css/adibaIcon.min.css",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/jmrashed"
  },
  "directories": {
    "doc": "docs",
    "example": "tools"
  },
  "engines": {
    "node": "^18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.1.2",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.34.1",
    "husky": "^9.0.0",
    "jsdom": "^24.0.0",
    "less-loader": "^12.3.2",
    "mini-css-extract-plugin": "^2.9.1",
    "postcss": "^8.5.8",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.3.0",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "vitest": "^1.6.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  }
}
